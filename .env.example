# ─────────────────────────────────────────────────────────────────────────────
# JANUS — plantilla de variables (SOLO NOMBRES, SIN VALORES).
# 1) Copia este archivo como .env.local  (cp .env.example .env.local)
# 2) Rellena SOLO lo que quieras activar. .env.local está ignorado por git:
#    nunca se sube, nunca va al chat, nunca entra en SQLite.
# 3) Comprueba:  npm run integrations:check   (no muestra ningún valor)
# 4) Arranca:    npm run start:local
# Detalle de cada integración: docs/integrations.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Founder (inicio de sesión desde el iPhone) ──
# Pega la llave PÚBLICA que muestra la app en «Vincular este dispositivo» (nunca una privada).
JANUS_FOUNDER_PUBLIC_KEY_PEM=
# Solo si Janus está detrás de un proxy HTTPS de confianza (p. ej. el que usas desde el iPhone).
JANUS_AUTH_TRUST_SECURE_PROXY=

# ── Base de datos local ──
JANUS_DB=data/janus.db
JANUS_TIME_ZONE=Europe/Amsterdam
# Minutos de espera de una aprobación (por defecto 15 min). En milisegundos.
JANUS_APPROVAL_TIMEOUT_MS=

# ── Cerebros de IA (cada uno se activa con llave + nombre de modelo) ──
# Modelo local o cualquier endpoint compatible OpenAI (va primero: local-first).
JANUS_MODEL_BASE_URL=
JANUS_MODEL_NAME=
JANUS_MODEL_API_KEY=
# ChatGPT (OpenAI)
JANUS_OPENAI_API_KEY=
JANUS_OPENAI_MODEL=
# Claude (Anthropic)
JANUS_ANTHROPIC_API_KEY=
JANUS_ANTHROPIC_MODEL=
# Gemini (Google)
JANUS_GEMINI_API_KEY=
JANUS_GEMINI_MODEL=
# Perplexity: la llave sirve para investigar con fuentes; el modelo, para usarlo también como cerebro.
PERPLEXITY_API_KEY=
JANUS_PERPLEXITY_MODEL=
# Orden de relevo opcional, p. ej.: custom,anthropic,openai,gemini,perplexity
JANUS_MODEL_ORDER=

# ── Código y publicación ──
GITHUB_TOKEN=
# Netlify lectura (qué versión está publicada, despliegues)
NETLIFY_AUTH_TOKEN=
# Netlify «volver a versión anterior» (llave aparte + sitios permitidos, separados por comas). Siempre pide aprobación.
NETLIFY_RELEASE_TOKEN=
JANUS_NETLIFY_RELEASE_SITES=
# Vercel (solo lectura de despliegues)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Supabase (solo lectura: salud, asesores, migraciones; nunca datos de clientes)
SUPABASE_ACCESS_TOKEN=

# ── Trabajo diario ──
# Google Workspace lectura (Drive, Gmail, Calendar)
GOOGLE_ACCESS_TOKEN=
# Google Workspace escritura (borradores de Gmail — nunca envía — y eventos). Permisos: gmail.compose, calendar.events
GOOGLE_WRITE_ACCESS_TOKEN=
# Asana (token personal)
ASANA_ACCESS_TOKEN=
# n8n (la API no está en la prueba gratuita). Webhooks autorizados: {"nombre":"https://…"}
N8N_BASE_URL=
N8N_API_KEY=
JANUS_N8N_WEBHOOKS=

# ── Creatividad (gastan créditos → siempre con aprobación) ──
RUNWAYML_API_SECRET=
RUNWAY_API_VERSION=
KLING_API_KEY=
KLING_DEFAULT_MODEL=

# ── Redes (ya existentes) ──
META_GRAPH_API_VERSION=
META_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# ── Estado de los asistentes publicados (opcional, JSON surfaceId → https URL) ──
JANUS_ASSISTANT_STATUS_URLS=
