{
  "name": "janus-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --import tsx apps/runtime/server.ts",
    "voice:start": "node scripts/start-local-voice.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "node --import tsx examples/observable-run.ts",
    "start:local": "node scripts/start-local.mjs",
    "integrations:check": "node scripts/check-integrations.mjs",
    "continuity": "node --import tsx scripts/continuity.ts",
    "build:attach": "node scripts/build-attach.mjs",
    "flow-editor:build": "node scripts/build-flow-editor.mjs",
    "flow-editor:e2e": "node scripts/flow-editor-e2e.mjs",
    "voice:independence": "node --import tsx scripts/voice-independence-check.ts",
    "dashboard:build": "node prototypes/dashboard/build.cjs && node prototypes/dashboard/build.cjs --skin b",
    "start:dashboards": "npm run dashboard:build && npm start",
    "dashboard:test": "node --test prototypes/dashboard/tests/avatar-catalog.test.cjs prototypes/dashboard/tests/core-bridge.test.cjs prototypes/dashboard/tests/core-serve.test.cjs"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
