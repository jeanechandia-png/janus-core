{
  "name": "janus-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --import tsx apps/runtime/server.ts",
    "voice:start": "node scripts/start-local-voice.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "node --import tsx examples/observable-run.ts",
    "start:local": "node scripts/start-local.mjs",
    "integrations:check": "node scripts/check-integrations.mjs",
    "continuity": "node --import tsx scripts/continuity.ts",
    "build:attach": "node scripts/build-attach.mjs",
    "flow-editor:build": "node scripts/build-flow-editor.mjs",
    "flow-editor:e2e": "node scripts/flow-editor-e2e.mjs",
    "voice:independence": "node --import tsx scripts/voice-independence-check.ts",
    "dashboard:build": "node scripts/build-janus-dashboards.mjs",
    "start:dashboards": "npm run dashboard:build && npm run start:local",
    "dashboard:test": "node --test prototypes/dashboard/tests/avatar-catalog.test.cjs prototypes/dashboard/tests/core-bridge.test.cjs prototypes/dashboard/tests/core-serve.test.cjs prototypes/dashboard/tests/public-safe.test.cjs prototypes/dashboard/tests/work-template.test.cjs prototypes/dashboard/tests/barcode-1d.test.cjs",
    "work:build": "node prototypes/dashboard/work/build-work.cjs",
    "work:smoke": "node tests/work-runtime-smoke.mjs",
    "work:push-key": "node --import tsx -e \"import('./packages/core/src/web-push.ts').then(m=>{const k=m.generateVapidPrivateKey();console.log('JANUS_PUSH_VAPID_PRIVATE_KEY='+k.privateKey+'\\n(clave publica: '+k.publicKey+')\\nGuarde la clave privada como variable de entorno del servidor. No la suba a GitHub.')})\""
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
