# JANUS local voice runtime — example only.
# Copy to .env.voice.local and replace every absolute path locally.
# Never commit .env.voice.local, models, reference audio, or private voice configs.

# Janus Core runtime
PORT=8787
JANUS_TIME_ZONE=Europe/Amsterdam

# Janus Core -> local voice adapters
JANUS_STT_BASE_URL=http://127.0.0.1:8080
JANUS_TTS_BASE_URL=http://127.0.0.1:8090
JANUS_VOICE_ID=REPLACE_WITH_APPROVED_LOCAL_VOICE_ID
JANUS_STT_LANGUAGE=es
JANUS_TTS_LANGUAGE=Spanish
JANUS_TTS_CHUNK_MS=40

# Proveedor de voz. 'local' (por defecto) o 'elevenlabs' (TEMPORAL y OPCIONAL; docs/voice-elevenlabs-provider.md).
# Con 'elevenlabs', la voz local de arriba queda como respaldo automático. La clave va en
# ELEVENLABS_API_KEY (gestor de secretos / .env.local), nunca aquí ni en Git.
JANUS_TTS_PROVIDER=local
# Solo el JANUS_VOICE_ID de arriba puede salir a la nube, mapeado a este voice_id de ElevenLabs.
JANUS_ELEVENLABS_VOICE_ID=
JANUS_ELEVENLABS_MODEL=eleven_multilingual_v2
JANUS_ELEVENLABS_LANGUAGE=es
JANUS_ELEVENLABS_MAX_CHARS=2000
# Tope diario opcional de caracteres enviados al proveedor (UTC). Vacío = sin tope propio.
JANUS_ELEVENLABS_DAILY_CHARS=
JANUS_TTS_FALLBACK_COOLDOWN_MS=60000

# whisper.cpp — local binary + multilingual model
WHISPER_SERVER_BIN=/ABSOLUTE/LOCAL/PATH/whisper.cpp/build/bin/whisper-server
WHISPER_MODEL=/ABSOLUTE/LOCAL/PATH/whisper.cpp/models/ggml-small.bin

# Qwen3-TTS sidecar — local Python + private voice config
JANUS_QWEN_PYTHON=/ABSOLUTE/LOCAL/PATH/janus-core/.venv-qwen/bin/python
JANUS_QWEN_VOICE_CONFIG=/ABSOLUTE/LOCAL/PATH/janus-core/config/voices.local.json
JANUS_QWEN_HOST=127.0.0.1
JANUS_QWEN_PORT=8090
JANUS_QWEN_DEVICE=
JANUS_QWEN_ALLOW_REMOTE_MODEL_ID=false
JANUS_QWEN_ALLOW_REMOTE_BIND=false
JANUS_QWEN_HTTP_LOG=false
